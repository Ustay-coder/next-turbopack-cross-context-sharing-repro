{
  "name": "next-turbopack-cross-context-sharing-repro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:webpack": "next build --webpack",
    "build:turbopack": "next build --turbopack",
